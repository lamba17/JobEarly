# ── JobEarly Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to git.

# ── Gmail / Google OAuth ───────────────────────────────────────────────────────
# Required for the Outreach Gmail integration.
#
# Step-by-step setup:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project (or select an existing one)
# 3. Enable the Gmail API:
#    APIs & Services → Library → search "Gmail API" → Enable
# 4. Create OAuth 2.0 credentials:
#    APIs & Services → Credentials → Create Credentials → OAuth client ID
#    - Application type: Web application
#    - Name: JobEarly (or anything)
#    - Authorised JavaScript origins: http://localhost:5173
#    - Authorised redirect URIs: http://localhost:5173
#    Click Create → copy the Client ID
# 5. Configure OAuth consent screen:
#    APIs & Services → OAuth consent screen
#    - User type: External
#    - App name: JobEarly
#    - Add scopes: Gmail API (gmail.readonly, gmail.send, gmail.modify)
#    - Add yourself as a test user (your Gmail address)
# 6. Paste the Client ID below:

VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Note: In development the OAuth popup works on http://localhost:5173
# For production deployment, add your production domain to Authorised JavaScript origins.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
# The publishable/anon key is safe to expose client-side — access is enforced by
# Row Level Security policies on each table, not by keeping this key secret.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# ── Welcome email (Gmail SMTP) ─────────────────────────────────────────────────
# Sends a "Thanks for signing up" email from the JobEarly Gmail account right
# after a new account is created. Server-side only — never exposed to the browser.
#
# Step-by-step setup (on the jobearlyteam@gmail.com account):
# 1. Turn on 2-Step Verification: myaccount.google.com/security
# 2. Go to myaccount.google.com/apppasswords (only appears once 2-Step Verification is on)
# 3. Create an app password named something like "JobEarly Server"
# 4. Copy the 16-character password it gives you (spaces don't matter) and paste below.
#    This is NOT your normal Gmail password — regular passwords no longer work for
#    SMTP login, only an App Password does.

GMAIL_USER=jobearlyteam@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# If these two aren't set, signup still works fine — the welcome email is just
# silently skipped (logged as a warning on the server), never blocks signup.
